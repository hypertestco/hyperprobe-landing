---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HyperProbe — Your 24/7 AI On-Call Agent</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="alternate icon" href="/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0A0A0A;
    --surface: #151515;
    --surface-2: #1C1B19;
    --border: #39342F;
    --text: #F5F0E8;
    --muted: #B8AEA5;
    --subtle: #968C84;
    --coral: #E8683A;
    --coral-dim: #C4521F;
    --green: #58B77C;
    --red: #D46B6B;
    --mono: 'JetBrains Mono', monospace;
    --serif: 'DM Serif Display', serif;
    --sans: 'Inter', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* NAV — dark for hero */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 48px;
    background: rgba(10,10,10,0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .nav-logo {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.08em;
    color: #F0EBE3;
    text-transform: uppercase;
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .nav-logo span { color: #F0EBE3; }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 32px;
  }

  .nav-links a {
    font-size: 13px;
    color: var(--subtle);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: #F5F0E8; }

  .yc-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    color: var(--subtle);
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .yc-mark {
    background: #E8601C;
    color: white;
    font-weight: 700;
    font-size: 11px;
    width: 20px; height: 20px;
    border-radius: 3px;
    display: flex; align-items: center; justify-content: center;
  }

  .nav-cta {
    background: var(--text);
    color: #0A0A0A;
    border: none;
    padding: 9px 20px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--sans);
    transition: background 0.2s;
    text-decoration: none;
    letter-spacing: 0.03em;
  }

  .nav-cta:hover { background: #F5F0E8; }

  .nav-book {
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
    font-family: var(--sans);
  }

  .nav-book:hover { color: #F0EBE3; }

  /* HERO — dark */
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 120px 48px 100px;
    text-align: center;
    position: relative;
    background: #0A0A0A;
    overflow: hidden;
  }

  /* Radiating lines from bottom center */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-conic-gradient(
        from 180deg at 50% 110%,
        transparent 0deg,
        transparent 5.5deg,
        rgba(196,98,45,0.18) 6deg,
        transparent 6.5deg
      );
    pointer-events: none;
  }

  /* No fade needed — next section is also dark */
  .hero::after { display: none; }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--subtle);
    text-transform: uppercase;
    margin-bottom: 32px;
    position: relative;
    z-index: 1;
  }

  .hero-eyebrow .yc-mark { width: 18px; height: 18px; font-size: 10px; }

  /* ALERT WIDGET */
  .hero-alert {
    background: #141414;
    border: 1px solid #2C2620;
    border-radius: 8px;
    padding: 14px 20px;
    margin-bottom: 44px;
    display: inline-flex;
    align-items: center;
    gap: 16px;
    font-family: var(--mono);
    font-size: 12px;
    box-shadow: 0 4px 24px rgba(0,0,0,0.4);
    position: relative;
    z-index: 1;
  }

  .alert-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: #E03B3B;
    flex-shrink: 0;
    animation: pulse 1.4s ease-in-out infinite;
    box-shadow: 0 0 0 0 rgba(224,59,59,0.4);
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(224,59,59,0.5); }
    70% { box-shadow: 0 0 0 8px rgba(224,59,59,0); }
    100% { box-shadow: 0 0 0 0 rgba(224,59,59,0); }
  }

  .alert-text {
    color: #C8C0B4;
    font-size: 12px;
  }

  .alert-text .alert-time { color: var(--subtle); }
  .alert-text .alert-service { color: #F5F0E8; font-weight: 500; }
  .alert-text .alert-count { color: #E03B3B; font-weight: 500; }

  .alert-badge {
    background: rgba(224,59,59,0.15);
    color: #E03B3B;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 3px;
    border: 1px solid rgba(224,59,59,0.3);
    flex-shrink: 0;
  }

  .hero h1 {
    font-family: var(--serif);
    font-size: clamp(40px, 5.5vw, 74px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    max-width: 860px;
    margin-bottom: 24px;
    color: #F5F0E8;
    position: relative;
    z-index: 1;
  }

  .hero h1 em { font-style: italic; color: var(--coral); }

  .hero-sub {
    font-size: clamp(15px, 1.7vw, 18px);
    color: var(--muted);
    max-width: 540px;
    line-height: 1.72;
    margin-bottom: 40px;
    font-weight: 400;
    position: relative;
    z-index: 1;
  }

  .hero-ctas {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 32px;
    position: relative;
    z-index: 1;
  }

  .btn-primary {
    background: var(--coral);
    color: white;
    border: none;
    padding: 13px 26px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--sans);
    transition: background 0.2s;
    text-decoration: none;
    display: inline-block;
    letter-spacing: 0.02em;
  }

  .btn-primary:hover { background: var(--coral-dim); }

  .btn-secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid var(--border);
    padding: 12px 24px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    font-family: var(--sans);
    transition: border-color 0.2s, color 0.2s;
    text-decoration: none;
    display: inline-block;
  }

  .btn-secondary:hover { border-color: var(--coral); color: var(--coral); }

  .hero-stack {
    font-size: 12px;
    color: var(--subtle);
    font-family: var(--mono);
    letter-spacing: 0.03em;
    position: relative;
    z-index: 2;
    margin-bottom: 60px;
  }

  /* SECTIONS */
  section {
    padding: 88px 48px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-divider { border-top: 1px solid var(--border); }

  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--coral);
    text-transform: uppercase;
    margin-bottom: 14px;
    display: block;
  }

  /* FEARS */
  .fears-wrap {
    padding: 0 48px 88px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .fears-header { margin-bottom: 36px; }

  .fears-header h2 {
    font-family: var(--serif);
    font-size: clamp(24px, 3vw, 38px);
    font-weight: 400;
    margin-bottom: 6px;
  }

  .fears-header p { font-size: 15px; color: var(--muted); }

  .fears-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .fear-card {
    background: var(--surface);
    padding: 36px 30px;
  }

  .fear-num {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--coral);
    letter-spacing: 0.1em;
    margin-bottom: 14px;
    display: block;
  }

  .fear-card h3 {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.25;
    margin-bottom: 12px;
  }

  .fear-card p { font-size: 14px; color: var(--muted); line-height: 1.75; }
  .fear-card p strong { color: var(--text); font-weight: 500; }

  .fear-consequence {
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px solid var(--border);
    font-size: 13px;
    color: var(--red);
    font-style: italic;
  }

  /* WHAT IT IS */
  .what-it-is { text-align: center; }

  .what-it-is h2 {
    font-family: var(--serif);
    font-size: clamp(26px, 3.8vw, 48px);
    font-weight: 400;
    line-height: 1.18;
    max-width: 880px;
    margin: 0 auto 20px;
  }

  .what-it-is h2 em { font-style: italic; color: var(--coral); }

  .what-it-is p {
    font-size: 16px;
    color: var(--muted);
    max-width: 520px;
    margin: 0 auto 32px;
    line-height: 1.72;
  }

  .probe-callout {
    background: var(--surface);
    border: 1px solid var(--border);
    border-left: 3px solid var(--coral);
    border-radius: 4px;
    padding: 18px 22px;
    max-width: 580px;
    margin: 0 auto 32px;
    text-align: left;
  }

  .probe-callout-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--coral);
    margin-bottom: 8px;
    display: block;
  }

  .probe-callout p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.7;
    margin: 0;
    max-width: none;
  }

  .probe-callout p strong { color: var(--text); }

  .what-it-is-differentiator {
    font-size: 15px;
    color: var(--coral);
    max-width: 520px;
    margin: 0 auto;
    font-style: italic;
    text-align: center;
  }

  .what-it-is-ctas {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* HOW IT WORKS */
  .how-it-works h2 {
    font-family: var(--serif);
    font-size: clamp(24px, 3.2vw, 40px);
    font-weight: 400;
    margin-bottom: 48px;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    position: relative;
    margin-bottom: 44px;
    gap: 0;
  }

  .steps::before {
    content: '';
    position: absolute;
    top: 24px; left: 10%; right: 10%;
    height: 1px;
    background: var(--border);
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 12px;
    position: relative;
  }

  .step-num {
    width: 48px; height: 48px;
    border-radius: 50%;
    background: var(--bg);
    border: 1px solid var(--border);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    margin-bottom: 16px;
    position: relative;
    z-index: 1;
  }

  .step.active .step-num {
    background: var(--coral);
    border-color: var(--coral);
    color: white;
    font-weight: 600;
  }

  .step-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text);
    margin-bottom: 8px;
  }

  .step.active .step-label { color: var(--coral); }

  .step-desc { font-size: 13px; color: var(--muted); line-height: 1.55; }

  .steps-note {
    font-size: 13px;
    color: var(--muted);
    border-left: 2px solid var(--coral);
    padding-left: 16px;
    max-width: 460px;
    margin-bottom: 44px;
  }

  .security-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .security-item {
    background: var(--surface);
    padding: 24px 26px;
  }

  .security-item h4 {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 6px;
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .security-item h4::before { content: '✓'; color: var(--coral); }

  .security-item p { font-size: 13px; color: var(--muted); line-height: 1.6; }

  /* INCIDENT TIMELINE (condensed) */
  .incident h2 {
    font-family: var(--serif);
    font-size: clamp(24px, 3.2vw, 40px);
    font-weight: 400;
    margin-bottom: 8px;
  }

  .incident-sub {
    color: var(--muted);
    font-size: 15px;
    margin-bottom: 48px;
    max-width: 480px;
  }

  .inc-row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: 32px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
    align-items: start;
  }

  .inc-row:first-child { border-top: 1px solid var(--border); }

  .inc-time {
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
    padding-top: 2px;
    line-height: 1.5;
  }

  .inc-time .inc-timestamp { display: block; color: var(--text); font-weight: 500; }

  .inc-body h3 {
    font-size: 16px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }

  .inc-body p { font-size: 14px; color: var(--muted); line-height: 1.7; margin-bottom: 12px; max-width: 580px; }
  .inc-body p strong { color: var(--text); font-weight: 500; }

  .terminal {
    background: #1C1814;
    border: 1px solid #2C2620;
    border-radius: 6px;
    padding: 16px 20px;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.8;
    max-width: 560px;
    margin-bottom: 12px;
  }

  .t-dim { color: var(--subtle); }
  .t-red { color: #D46B6B; }
  .t-coral { color: #E87A4A; }
  .t-green { color: #4DAA75; }
  .t-white { color: #F5F0E8; }
  .t-label {
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--subtle);
    margin-bottom: 8px;
    display: block;
    border-bottom: 1px solid #2C2620;
    padding-bottom: 6px;
  }

  .inc-note {
    font-size: 13px;
    color: var(--muted);
    border-left: 2px solid var(--border);
    padding-left: 12px;
    font-style: italic;
    max-width: 480px;
  }

  .inc-note.coral { border-left-color: var(--coral); color: var(--text); font-style: normal; }

  .rca-nums {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    max-width: 500px;
    margin-top: 16px;
  }

  .rca-num {
    background: var(--surface);
    padding: 20px 14px;
    text-align: center;
  }

  .rca-num .big {
    font-family: var(--serif);
    font-size: 28px;
    color: var(--coral);
    display: block;
    line-height: 1;
    margin-bottom: 5px;
  }

  .rca-num .lbl { font-size: 12px; color: var(--muted); font-family: var(--mono); }

  /* BEFORE AFTER */
  .before-after h2 {
    font-family: var(--serif);
    font-size: clamp(24px, 3.2vw, 40px);
    font-weight: 400;
    margin-bottom: 8px;
  }

  .ba-sub { color: var(--muted); font-size: 15px; margin-bottom: 40px; max-width: 480px; }

  .ba-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .ba-col { background: var(--surface); padding: 32px; }

  .ba-col-label {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .ba-col-label.before { color: var(--red); }
  .ba-col-label.after { color: var(--green); }

  .ba-col-label::before {
    content: '';
    width: 7px; height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .ba-rows { display: flex; flex-direction: column; gap: 0; }

  .ba-row {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 14px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  .ba-row:last-child { border-bottom: none; }

  .ba-t { font-family: var(--mono); font-size: 12px; color: var(--muted); padding-top: 1px; }

  .ba-txt { font-size: 13px; color: var(--text); line-height: 1.5; }
  .ba-txt.muted { color: var(--muted); }
  .ba-txt.bad { color: var(--red); }
  .ba-txt.good { color: var(--green); font-weight: 500; }

  /* FOR YOU IF */
  .for-you {
    background: var(--surface);
    border-top: 1px solid var(--border);
    padding: 88px 48px;
  }

  .for-you-inner { max-width: 1100px; margin: 0 auto; }

  .for-you-inner h2 {
    font-family: var(--serif);
    font-size: clamp(24px, 3.2vw, 40px);
    font-weight: 400;
    margin-bottom: 6px;
  }

  .for-you-sub { color: var(--muted); font-size: 15px; margin-bottom: 44px; }

  .for-you-opener {
    background: var(--bg);
    border: 1px solid var(--border);
    border-left: 3px solid var(--coral);
    border-radius: 4px;
    padding: 20px 24px;
    margin-bottom: 36px;
    max-width: 740px;
  }

  .for-you-opener p {
    font-size: 15px;
    color: var(--text);
    line-height: 1.7;
    font-style: italic;
  }

  .for-you-opener p strong { font-style: normal; color: var(--coral); }

  .for-you-list { display: flex; flex-direction: column; border-top: 1px solid var(--border); }

  .for-you-item {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 48px;
    padding: 30px 0;
    border-bottom: 1px solid var(--border);
  }

  .for-you-item h3 { font-size: 14px; font-weight: 600; color: var(--text); line-height: 1.45; }

  .for-you-item p { font-size: 14px; color: var(--muted); line-height: 1.75; }
  .for-you-item p strong { color: var(--text); font-weight: 500; }

  /* COVERAGE */
  .coverage h2 {
    font-family: var(--serif);
    font-size: clamp(22px, 2.8vw, 36px);
    font-weight: 400;
    margin-bottom: 10px;
  }

  .coverage-sub { color: var(--muted); font-size: 15px; margin-bottom: 36px; max-width: 520px; }

  .coverage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .coverage-item {
    background: var(--surface);
    padding: 24px 22px;
  }

  .coverage-item h4 { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 6px; }
  .coverage-item p { font-size: 13px; color: var(--muted); line-height: 1.6; }

  .coverage-coming {
    font-size: 13px;
    color: var(--muted);
    font-family: var(--mono);
    padding: 12px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    display: inline-block;
  }

  .coverage-coming span { color: var(--coral); }

  /* METRICS ROW */
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    margin: 36px auto;
