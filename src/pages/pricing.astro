---
export const prerender = true;
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>HyperProbe — Pricing</title>
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="alternate icon" href="/favicon.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg: #0A0A0A;
    --surface: #111111;
    --surface-2: #161616;
    --border: #242424;
    --text: #F0EBE3;
    --muted: #9A8E84;
    --coral: #E8683A;
    --coral-dim: #C4521F;
    --green: #2D7A4A;
    --mono: 'JetBrains Mono', monospace;
    --serif: 'DM Serif Display', serif;
    --sans: 'Inter', sans-serif;
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 48px;
    background: rgba(10,10,10,0.95);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid #1E1E1E;
  }

  .nav-logo {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 15px;
    letter-spacing: 0.08em;
    color: #F0EBE3;
    text-transform: uppercase;
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .nav-logo span { color: #F0EBE3; }

  .yc-badge {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 11px;
    color: var(--muted);
    font-weight: 500;
    letter-spacing: 0.05em;
  }

  .yc-mark {
    background: #E8601C;
    color: white;
    font-weight: 700;
    font-size: 11px;
    width: 20px; height: 20px;
    border-radius: 3px;
    display: flex; align-items: center; justify-content: center;
  }

  .nav-cta {
    background: white;
    color: #0A0A0A;
    border: none;
    padding: 9px 20px;
    border-radius: 4px;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--sans);
    transition: background 0.2s;
    text-decoration: none;
  }

  .nav-cta:hover { background: #F0EBE3; }

  /* LAYOUT */
  .page { padding-top: 80px; }

  section {
    padding: 88px 48px;
    max-width: 1100px;
    margin: 0 auto;
  }

  .section-divider { border-top: 1px solid var(--border); }

  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--coral);
    text-transform: uppercase;
    margin-bottom: 14px;
    display: block;
  }

  /* HEADER */
  .pricing-header { text-align: center; }

  .pricing-header h1 {
    font-family: var(--serif);
    font-size: clamp(36px, 5vw, 64px);
    font-weight: 400;
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: 20px;
  }

  .pricing-header h1 em { font-style: italic; color: var(--coral); }

  .pricing-header-lede {
    font-size: 16px;
    color: var(--muted);
    max-width: 560px;
    margin: 0 auto 16px;
    line-height: 1.7;
  }

  .pricing-trust {
    font-size: 12px;
    color: var(--muted);
    font-family: var(--mono);
    letter-spacing: 0.02em;
  }

  /* TIER CARDS */
  .tier-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    margin-top: 56px;
  }

  .tier-card {
    background: var(--surface);
    padding: 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .tier-card-featured {
    background: var(--bg);
    position: relative;
    border-left: 2px solid var(--coral);
    border-right: 2px solid var(--coral);
  }

  .tier-badge {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--coral);
  }

  .tier-name {
    font-size: 18px;
    font-weight: 700;
    color: var(--text);
    letter-spacing: 0.02em;
  }

  .tier-price {
    font-family: var(--serif);
    font-size: 44px;
    color: var(--text);
    line-height: 1;
  }

  .tier-price .qualifier {
    font-family: var(--sans);
    font-size: 13px;
    color: var(--muted);
    font-weight: 400;
  }

  .tier-note {
    font-size: 12px;
    color: var(--muted);
    font-family: var(--mono);
    margin-top: -6px;
  }

  .tier-desc {
    font-size: 14px;
    color: var(--muted);
    line-height: 1.7;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .tier-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 9px;
    flex: 1;
  }

  .tier-features li {
    font-size: 13px;
    color: var(--text);
    display: flex;
    gap: 10px;
    align-items: baseline;
    line-height: 1.5;
    text-align: left;
  }

  .tier-features li::before {
    content: '·';
    color: var(--coral);
    font-size: 18px;
    line-height: 1;
    flex-shrink: 0;
  }

  .tier-features .section-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 8px;
    display: block;
  }

  .tier-features .section-label::before { display: none; }

  .tier-cta {
    margin-top: 8px;
  }

  .btn-primary {
    background: var(--coral);
    color: white;
    border: none;
    padding: 13px 26px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    font-family: var(--sans);
    transition: background 0.2s;
    text-decoration: none;
    display: inline-block;
    width: 100%;
    text-align: center;
  }

  .btn-primary:hover { background: var(--coral-dim); }

  .btn-secondary {
    background: transparent;
    color: var(--text);
    border: 1px solid #3A3A3A;
    padding: 12px 24px;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    font-family: var(--sans);
    transition: border-color 0.2s, color 0.2s;
    text-decoration: none;
    display: inline-block;
    width: 100%;
    text-align: center;
  }

  .btn-secondary:hover { border-color: var(--coral); color: var(--coral); }

  .install-prompt {
    background: #1E1E1E;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 8px;
  }

  .install-label {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .install-link {
    font-size: 13px;
    color: var(--coral);
    text-decoration: none;
    font-weight: 500;
  }

  .install-link:hover { text-decoration: underline; }

  /* PROBE CONTROLS */
  .probe-controls h2 {
    font-family: var(--serif);
    font-size: clamp(22px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 10px;
  }

  .probe-controls-intro {
    font-size: 15px;
    color: var(--muted);
    margin-bottom: 40px;
    max-width: 560px;
  }

  .probe-controls-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 20px;
  }

  .probe-control-item {
    background: var(--surface);
    padding: 28px 28px;
  }

  .probe-control-item h4 {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }

  .probe-control-item p {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.7;
  }

  .probe-controls-close {
    font-size: 13px;
    color: var(--muted);
    border-left: 2px solid var(--coral);
    padding-left: 14px;
    max-width: 600px;
    font-style: italic;
  }

  /* COMPARISON TABLE */
  .comparison h2 {
    font-family: var(--serif);
    font-size: clamp(22px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 40px;
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .comparison-table th {
    text-align: left;
    padding: 12px 16px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    border-bottom: 2px solid var(--border);
    background: var(--surface);
  }

  .comparison-table th:first-child { width: 40%; }
  .comparison-table th:not(:first-child) { text-align: center; width: 20%; }

  .comparison-table th.featured { color: var(--coral); }

  .comparison-table td {
    padding: 11px 16px;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    vertical-align: middle;
  }

  .comparison-table td:not(:first-child) {
    text-align: center;
    font-family: var(--mono);
    font-size: 12px;
  }

  .comparison-table td.included { color: var(--green); font-family: var(--sans); font-size: 13px; }
  .comparison-table td.not-included { color: var(--border); }

  .comparison-table .group-label td {
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 24px;
    padding-bottom: 8px;
    border-bottom: none;
    background: transparent;
  }

  .comparison-table tr:hover td { background: #161616; }
  .comparison-table .group-label:hover td { background: transparent; }

  /* FAQ */
  .faq-section h2 {
    font-family: var(--serif);
    font-size: clamp(22px, 3vw, 36px);
    font-weight: 400;
    margin-bottom: 48px;
  }

  .faq-list { display: flex; flex-direction: column; border-top: 1px solid var(--border); }

  .faq-item {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    padding: 28px 0;
    border-bottom: 1px solid var(--border);
  }

  .faq-item h3 { font-size: 14px; font-weight: 600; color: var(--text); line-height: 1.5; }
  .faq-item p { font-size: 14px; color: var(--muted); line-height: 1.75; }

  /* POC CLOSE */
  .poc-close {
    text-align: center;
    background: #111111;
    border-top: 1px solid var(--border);
    padding: 88px 48px;
  }

  .poc-close h2 {
    font-family: var(--serif);
    font-size: clamp(28px, 4vw, 52px);
    font-weight: 400;
    line-height: 1.12;
    max-width: 660px;
    margin: 0 auto 16px;
  }

  .poc-close h2 em { font-style: italic; color: var(--coral); }

  .poc-close-sub {
    color: var(--muted);
    font-size: 16px;
    margin-bottom: 40px;
    max-width: 440px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-form { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-bottom: 16px; }

  .cta-form input {
    background: #161616;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 12px 16px;
    font-size: 14px;
    color: #F0EBE3;
    font-family: var(--sans);
    width: 200px;
    outline: none;
    transition: border-color 0.2s;
  }

  .cta-form input:focus { border-color: var(--coral); }
  .cta-form input::placeholder { color: var(--muted); }

  .cta-fine { font-size: 12px; color: var(--muted); font-family: var(--mono); }

  /* FOOTER */
  footer {
    border-top: 1px solid var(--border);
    padding: 28px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  footer p { font-size: 12px; color: var(--muted); }

  /* RESPONSIVE */
  @media (max-width: 800px) {
    nav { padding: 14px 20px; }
    section { padding: 60px 20px; }
    .tier-cards { grid-template-columns: 1fr; }
    .probe-controls-grid { grid-template-columns: 1fr; }
    .faq-item { grid-template-columns: 1fr; gap: 8px; }
    .comparison-table th:first-child { width: 50%; }
    .poc-close { padding: 60px 20px; }
    footer { flex-direction: column; gap: 10px; text-align: center; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="/" class="nav-logo">
    <svg width="22" height="22" viewBox="0 0 192 192" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" style="margin-right:10px;vertical-align:middle;flex-shrink:0;">
      <path d="M94.6 6.36L173.3 130L133.56 131.6L75.31 39.84Z" fill="currentColor"/>
      <path d="M18.36 124.43L55.57 69.37L115.79 158.48L95.45 185.58L53.54 124.43H18.36Z" fill="currentColor"/>
    </svg>Hyper<span>Probe</span>
  </a>
  <div class="yc-badge"><div class="yc-mark">Y</div> Backed by Y Combinator</div>
  <a href="https://docs.hyperprobe.co/quickstart" class="nav-cta">Try Now →</a>
</nav>

<div class="page">

<!-- HEADER -->
<section class="pricing-header">
  <span class="eyebrow">Pricing</span>
  <h1>Priced per service.<br><em>Never per engineer.</em></h1>
  <p class="pricing-header-lede">A service is one running application with the SDK installed, however many instances it runs on. Probes and captures are unlimited on every plan, because nothing about debugging should be metered.</p>
  <p class="pricing-trust">First incident we work with you is free · Cancel any month · No seat counts · No host counts · No capture limits</p>

  <!-- TIER CARDS -->
  <div class="tier-cards">

    <!-- FREE -->
    <div class="tier-card">
      <div class="tier-name">Free</div>
      <div class="tier-price">$0 <span class="qualifier">forever</span></div>
      <div class="tier-note">1 service · managed cloud</div>
      <p class="tier-desc">Install the SDK and see a real capture the same afternoon.</p>
      <ul class="tier-features">
        <li>Unlimited probes and captures</li>
        <li>Full probe configuration: TTL, rate limit, hit expiry</li>
        <li>MCP server for Cursor, Claude Code, Codex, opencode</li>
        <li>All supported runtimes</li>
        <li>7-day capture history</li>
        <li>Default PII redaction</li>
        <li>Immutable audit log</li>
        <li>Community support</li>
      </ul>
      <div class="tier-cta">
        <div class="install-prompt">
          <span class="install-label">Install with your coding agent</span>
          <a href="https://docs.hyperprobe.co/sdks/with-ai-agent" class="install-link">Installation docs →</a>
        </div>
      </div>
    </div>

    <!-- PROFESSIONAL -->
    <div class="tier-card tier-card-featured">
      <div class="tier-badge">Most teams</div>
      <div class="tier-name">Professional</div>
      <div class="tier-price">$99 <span class="qualifier">per service per month</span></div>
      <div class="tier-note">$79 billed annually · 3 service minimum</div>
      <p class="tier-desc">For teams running real production traffic who want the whole stack instrumented, not one service.</p>
      <ul class="tier-features">
        <li>Everything in Free</li>
        <li>Unlimited services</li>
        <li>30-day capture history</li>
        <li>Team-level probe policy: TTL, rate limit, hit expiry</li>
        <li>RBAC</li>
        <li>Google and GitHub SSO</li>
        <li>Self-hosted available on request</li>
        <li>Shared Slack channel, 1 business day response</li>
      </ul>
      <div class="tier-cta">
        <a href="https://docs.hyperprobe.co/quickstart" class="btn-primary">Try Now →</a>
      </div>
    </div>

    <!-- ENTERPRISE -->
    <div class="tier-card">
      <div class="tier-name">Enterprise</div>
      <div class="tier-price">Custom</div>
      <div class="tier-note">Annual contract · volume pricing</div>
      <p class="tier-desc">For teams whose security review has to sign off before anything touches production.</p>
      <ul class="tier-features">
        <li>Everything in Professional</li>
        <li>Self-hosted or private VPC</li>
        <li>Data residency in your chosen region</li>
        <li>Custom capture history retention</li>
        <li>Org-level probe policy: max TTL, mandatory expiry, per-namespace allow lists</li>
        <li>Approval gates before a probe arms</li>
        <li>RBAC</li>
        <li>Custom PII redaction rules per field and per file</li>
        <li>SAML SSO and SCIM provisioning</li>
        <li>Security review support and DPA</li>
        <li>Named engineer and contracted SLA</li>
      </ul>
      <div class="tier-cta">
        <a href="https://calendly.com/shailendra-hyperprobe/30min" class="btn-secondary">Talk to us</a>
      </div>
    </div>

  </div>
</section>

<!-- HOW PROBES ARE CONTROLLED -->
<section class="probe-controls section-divider">
  <span class="eyebrow">How probes are controlled</span>
  <h2>Unlimited probes. Bounded by controls you set.</h2>
  <p class="probe-controls-intro">Nothing about debugging is metered. Every probe is bounded by controls you set instead.</p>

  <div class="probe-controls-grid">
    <div class="probe-control-item">
      <h4>Time to live</h4>
      <p>Every probe carries an expiry. Set it in seconds or minutes. When the clock runs out the probe clears itself, whether or not it ever fired.</p>
    </div>
    <div class="probe-control-item">
      <h4>Rate limit</h4>
      <p>Cap how often a probe is allowed to capture. High-traffic lines stay bounded no matter how much traffic they see.</p>
    </div>
    <div class="probe-control-item">
      <h4>Hit expiry</h4>
      <p>Set the number of captures a probe is allowed. Once it has collected what you need, it clears itself.</p>
    </div>
  </div>

  <p class="probe-controls-close">On Enterprise your security team sets the ceilings on all three at the organisation level, so nobody can place a probe outside policy.</p>
</section>

<!-- COMPARISON TABLE -->
<section class="comparison section-divider">
  <span class="eyebrow">Full comparison</span>
  <h2>What is in each plan.</h2>

  <table class="comparison-table">
    <thead>
      <tr>
        <th></th>
        <th>Free</th>
        <th class="featured">Professional</th>
        <th>Enterprise</th>
      </tr>
    </thead>
    <tbody>
      <tr class="group-label"><td colspan="4">Probes and captures</td></tr>
      <tr><td>Probes</td><td>Unlimited</td><td>Unlimited</td><td>Unlimited</td></tr>
      <tr><td>Captures</td><td>Unlimited</td><td>Unlimited</td><td>Unlimited</td></tr>
      <tr><td>Probe TTL, rate limit, hit expiry</td><td class="included">Included</td><td class="included">Included</td><td class="included">Included</td></tr>
      <tr><td>Team-level probe policy</td><td class="not-included">—</td><td class="included">Included</td><td class="included">Included</td></tr>
      <tr><td>Org-level probe policy and ceilings</td><td class="not-included">—</td><td class="not-included">—</td><td class="included">Included</td></tr>

      <tr class="group-label"><td colspan="4">Scope</td></tr>
      <tr><td>Services</td><td>1</td><td>Unlimited</td><td>Unlimited</td></tr>
      <tr><td>Team members</td><td>Unlimited</td><td>Unlimited</td><td>Unlimited</td></tr>
      <tr><td>Capture history</td><td>7 days</td><td>30 days</td><td>Custom</td></tr>

      <tr class="group-label"><td colspan="4">Agent</td></tr>
      <tr><td>MCP server for every coding agent</td><td class="included">Included</td><td class="included">Included</td><td class="included">Included</td></tr>
      <tr><td>All supported runtimes</td><td class="included">Included</td><td class="included">Included</td><td class="included">Included</td></tr>

      <tr class="group-label"><td colspan="4">Deployment</td></tr>
      <tr><td>Managed cloud</td><td class="included">Included</td><td class="included">Included</td><td class="included">Included</td></tr>
      <tr><td>Self-hosted or private VPC</td><td class="not-included">—</td><td>On request</td><td class="included">Included</td></tr>
      <tr><td>Data residency</td><td class="not-included">—</td><td class="not-included">—</td><td class="included">Included</td></tr>

      <tr class="group-label"><td colspan="4">Security and governance</td></tr>
      <tr><td>Read-only by architecture</td><td class="included">Included</td><td class="included">Included</td><td class="included">Included</td></tr>
      <tr><td>Default PII redaction</td><td class="included">Included</td><td class="included">Included</td><td class="included">Included</td></tr>
      <tr><td>Immutable audit log</td><td class="included">Included</td><td class="included">Included</td><td class="included">Included</td></tr>
      <tr><td>Custom redaction rules per field and file</td><td class="not-included">—</td><td class="not-included">—</td><td class="included">Included</td></tr>
      <tr><td>Approval gates before a probe arms</td><td class="not-included">—</td><td class="not-included">—</td><td class="included">Included</td></tr>
      <tr><td>RBAC</td><td class="not-included">—</td><td class="included">Included</td><td class="included">Included</td></tr>
      <tr><td>Per-namespace probe policy</td><td class="not-included">—</td><td class="not-included">—</td><td class="included">Included</td></tr>
      <tr><td>SSO</td><td class="not-included">—</td><td>Google, GitHub</td><td>SAML, SCIM</td></tr>

      <tr class="group-label"><td colspan="4">Support</td></tr>
      <tr><td>Channel</td><td>Community</td><td>Shared Slack</td><td>Named engineer</td></tr>
