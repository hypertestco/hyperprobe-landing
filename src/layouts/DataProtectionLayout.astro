---
import Layout from './Layout.astro';

const { title, description } = Astro.props.frontmatter;
---

<Layout title={title} description={description} schemaTypes={[]}>
  <header class="sticky top-0 z-50 flex min-h-[58px] items-center border-b border-white/10 bg-[#0a0a0a]/95 px-5 py-[14px] backdrop-blur-xl md:px-12 md:py-[18px]">
    <a href="/" class="inline-flex items-center font-sans text-[15px] font-bold uppercase tracking-[0.08em] text-[#f0ebe3] no-underline" aria-label="HyperProbe home">
      <svg width="22" height="22" viewBox="0 0 192 192" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="mr-[10px] h-[22px] w-[22px] shrink-0 align-middle">
        <path d="M94.6 6.36L173.3 130L133.56 131.6L75.31 39.84Z" fill="currentColor" />
        <path d="M18.36 124.43L55.57 69.37L115.79 158.48L95.45 185.58L53.54 124.43H18.36Z" fill="currentColor" />
      </svg>
      <span>HyperProbe</span>
    </a>
  </header>

  <main class="relative z-10 flex-grow px-4 py-16 sm:px-6 md:py-24 lg:px-8">
    <article class="policy-copy mx-auto max-w-4xl text-[15px] leading-7 text-zinc-600">
      <slot />
    </article>
  </main>

  <footer class="mt-auto flex w-full flex-col items-center justify-between gap-3 border-t border-zinc-200 px-5 py-7 text-center md:flex-row md:px-12 md:text-left">
    <a href="/" class="inline-flex items-center font-sans text-[15px] font-bold uppercase tracking-[0.08em] text-zinc-900 no-underline">
      <svg width="20" height="20" viewBox="0 0 192 192" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" class="mr-2 h-5 w-5 shrink-0">
        <path d="M94.6 6.36L173.3 130L133.56 131.6L75.31 39.84Z" fill="currentColor" />
        <path d="M18.36 124.43L55.57 69.37L115.79 158.48L95.45 185.58L53.54 124.43H18.36Z" fill="currentColor" />
      </svg>
      HyperProbe
    </a>
    <a href="/privacy-policy" class="text-xs text-zinc-500 hover:text-zinc-900">Privacy Policy</a>
    <p class="text-xs text-zinc-500">© 2026 HyperProbe · YC S26 · hyperprobe.co</p>
  </footer>
</Layout>

<style>
  .policy-copy :global(h1) { margin-bottom: 1.5rem; color: #09090b; font-family: Georgia, 'Times New Roman', serif; font-size: clamp(2.25rem, 5vw, 3rem); line-height: 1.1; letter-spacing: -0.03em; }
  .policy-copy :global(h2) { margin: 3rem 0 0.75rem; color: #18181b; font-family: Georgia, 'Times New Roman', serif; font-size: 1.5rem; line-height: 1.3; letter-spacing: -0.02em; }
  .policy-copy :global(h3) { margin: 1.75rem 0 0.6rem; color: #27272a; font-size: 1rem; font-weight: 600; }
  .policy-copy :global(p) { margin: 0.85rem 0; }
  .policy-copy :global(strong) { color: #27272a; font-weight: 600; }
  .policy-copy :global(a) { color: #c2412d; text-decoration: underline; text-underline-offset: 3px; }
  .policy-copy :global(hr) { margin: 2.5rem 0; border: 0; border-top: 1px solid #e4e4e7; }
  .policy-copy :global(ul), .policy-copy :global(ol) { margin: 0.8rem 0 0.8rem 1.5rem; }
  .policy-copy :global(ul) { list-style: disc; }
  .policy-copy :global(ol) { list-style: decimal; }
  .policy-copy :global(li) { margin: 0.6rem 0; padding-left: 0.2rem; }
  .policy-copy :global(li ul) { margin-top: 0.3rem; }
  .policy-copy :global(code) { overflow-wrap: anywhere; font-size: 0.88em; }
  .policy-copy :global(pre) { max-width: 100%; margin: 1.25rem 0; overflow-x: auto; border: 1px solid #e4e4e7; padding: 1.25rem; font-size: 0.75rem; line-height: 1.6; }
  .policy-copy :global(pre code) { overflow-wrap: normal; font-size: inherit; }
  .policy-copy :global(table) { display: block; max-width: 100%; margin: 1.25rem 0; overflow-x: auto; border: 1px solid #e4e4e7; border-collapse: collapse; text-align: left; }
  .policy-copy :global(th), .policy-copy :global(td) { min-width: 13rem; padding: 0.9rem 1rem; vertical-align: top; border-bottom: 1px solid #e4e4e7; }
  .policy-copy :global(th) { background: #fafafa; color: #27272a; font-weight: 600; }
  .policy-copy :global(tr:last-child td) { border-bottom: 0; }
</style>
